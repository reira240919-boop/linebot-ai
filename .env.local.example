# このファイルを .env.local にコピーして、値を入れる（.env.local は git に入らない）
# LINE Developers > 該当チャネル > チャネル基本設定
LINE_CHANNEL_SECRET=
# LINE Developers > 該当チャネル > Messaging API設定
LINE_CHANNEL_ACCESS_TOKEN=

# Supabase（サーバー側だけで使う）
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Claude API
ANTHROPIC_API_KEY=
# 答えられない質問の通知先（オーナーの LINE ユーザーID）
OWNER_LINE_USER_ID=
# 管理画面の合言葉
ADMIN_PASSWORD=
